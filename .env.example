# Database Configuration
DOCRAIDER_DB_HOST=localhost
DOCRAIDER_DB_PORT=5432
DOCRAIDER_DB_NAME=docraider
DOCRAIDER_DB_USER=postgres
DOCRAIDER_DB_PASSWORD=your_password_here
DOCRAIDER_DB_SSL=false
DOCRAIDER_DB_POOL_MAX=20
DOCRAIDER_DB_POOL_MIN=5

# Server Configuration (optional)
HOST=localhost
PORT=3000
MAX_CONNECTIONS=200

# Search Configuration (optional)
DOCRAIDER_FTS_LANGUAGE=english

# Crawler Configuration (optional)
DOCRAIDER_CRAWLER_USER_AGENT=Docraider-MCP/1.0
DOCRAIDER_CRAWLER_BACKOFF_INITIAL_MS=1000
DOCRAIDER_CRAWLER_BACKOFF_MAX_MS=30000
DOCRAIDER_CRAWLER_BACKOFF_MULTIPLIER=2

# Embedding configuration (OpenAI-compatible API)
EMBEDDING_ENDPOINT=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=30000